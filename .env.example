# Copy this file to .env and set the key(s) of the LLM provider(s) you use.
# Both the annotator and the generator read it. No key is required for an OpenAI-compatible
# endpoint that is selected with -hostname (e.g. llama.cpp).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_API_KEY=   # optional, only for Ollama servers that require a bearer token

OLLAMA_HOSTNAME=  # optional, base URL of the Ollama server (default: local server); overridden by -hostname

# Generator only
# Endpoint of an OpenAI-compatible server (overridden by -hostname). Must include /v1.
# OPENAI_API_BASE=http://localhost:8080/v1
